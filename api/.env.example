NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3000
ADMIN_RUNTIME_MODE=mock

# Reserved Prompt 34 placeholders. Values must be supplied privately later;
# the current runtime remains mock-backed and does not read these yet.
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

SUPABASE_APP_SCHEMA=app
SUPABASE_EXPOSE_APP_SCHEMA=false
SUPABASE_RLS_REQUIRED_BEFORE_EXPOSURE=true

AUTH_PROVIDER=mock
ADMIN_READ_MODEL_SOURCE=mock
ADMIN_COMMAND_SOURCE=mock
ACCESS_EVALUATOR_SOURCE=mock
MEDIA_AUTH_SOURCE=mock
PAYMENT_PROVIDER=mock

ADMIN_READ_MODEL_SOURCE_FUTURE=postgres
AUTH_PROVIDER_FUTURE=supabase

# SUPABASE_SECRET_KEY and SUPABASE_DB_URL are server-side only.
