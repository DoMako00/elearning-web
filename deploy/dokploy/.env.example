# Dokploy Compose defaults. Do not put real credentials in this file.
# Local tests may still use mock adapters, but this Dokploy production profile
# must run only with the real Supabase/Postgres providers below. Configure real
# secrets exclusively through Dokploy's Environment UI.
NODE_ENV=production
ADMIN_RUNTIME_MODE=supabase
PERSISTENCE_PROVIDER=supabase
AUTH_PROVIDER=supabase
ADMIN_READ_MODEL_SOURCE=postgres
ADMIN_M2_READ_MODEL_SOURCE=postgres
ADMIN_COMMAND_SOURCE=postgres
VITE_ADMIN_DATA_SOURCE=api
# The web container proxies this path to the private api service.
VITE_API_BASE_URL=/api
WEB_PORT=8080

# Dokploy may inject these values through its environment UI instead of using .env.

# Required production values. Keep the actual values out of Git.
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DB_URL=

# Browser-safe build-time settings for the Vite web app. They use the same
# project URL/public key, but must be named VITE_* because Vite injects them
# while building the static web files.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_APP_SCHEMA=app
SUPABASE_EXPOSE_APP_SCHEMA=false
SUPABASE_RLS_REQUIRED_BEFORE_EXPOSURE=true

# The remaining modules are not deployed application providers yet.
ACCESS_EVALUATOR_SOURCE=mock
MEDIA_AUTH_SOURCE=mock
PAYMENT_PROVIDER=mock

# Do not put real Supabase values in this committed example file.
