# Dokploy Compose defaults. Do not put real credentials in this file.
# Keep the defaults mock-backed locally. Configure real values only through
# Dokploy's Environment UI for an explicitly approved staging deployment.
NODE_ENV=production
ADMIN_RUNTIME_MODE=mock
VITE_ADMIN_DATA_SOURCE=mock
# The web container proxies this path to the private api service.
VITE_API_BASE_URL=/api
WEB_PORT=8080

# Dokploy may inject these values through its environment UI instead of using .env.

# Reserved Prompt 34 placeholders only. The current Compose/runtime remains
# mock-backed and does not consume these until a later provider phase.
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DB_URL=

# Browser-safe build-time settings for the Vite web app. They use the same
# project URL/public key, but must be named VITE_* because Vite injects them
# while building the static web files.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_APP_SCHEMA=app
SUPABASE_EXPOSE_APP_SCHEMA=false
SUPABASE_RLS_REQUIRED_BEFORE_EXPOSURE=true

AUTH_PROVIDER=mock
ADMIN_READ_MODEL_SOURCE=mock
ADMIN_M2_READ_MODEL_SOURCE=mock
ADMIN_COMMAND_SOURCE=mock
ACCESS_EVALUATOR_SOURCE=mock
MEDIA_AUTH_SOURCE=mock
PAYMENT_PROVIDER=mock

# Do not put real Supabase values in this committed example file.
