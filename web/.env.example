VITE_ADMIN_DATA_SOURCE=mock
VITE_API_BASE_URL=http://localhost:3000

# Reserved public/client placeholders for a future approved browser-auth phase.
# The current frontend remains mock-backed and does not read these yet.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Never add secret keys or database URLs to VITE_ variables.
# ============================================================
# General runtime
# ============================================================
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
WEB_PORT=8080


# ============================================================
# API: switch from mock to real Supabase-backed admin reads
# ============================================================
ADMIN_RUNTIME_MODE=supabase
PERSISTENCE_PROVIDER=supabase
AUTH_PROVIDER=supabase

ADMIN_READ_MODEL_SOURCE=postgres
ADMIN_M2_READ_MODEL_SOURCE=postgres

# Keep Admin write operations disabled for now.
ADMIN_COMMAND_SOURCE=postgres


# ============================================================
# Supabase: API/server only
# ============================================================
SUPABASE_PROJECT_REF=qpsiognqssbzbjedhuwc
SUPABASE_URL=https://qpsiognqssbzbjedhuwc.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_aJ73qvqQvBFgl-SlytXWow_6LlLjEx2

# Copy this from Supabase Dashboard → Connect.
# It must be a PostgreSQL connection URL ending with sslmode=verify-full.
SUPABASE_DB_URL=postgresql://postgres.qpsiognqssbzbjedhuwc:Lamplampkok399@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=verify-full

SUPABASE_APP_SCHEMA=app
SUPABASE_EXPOSE_APP_SCHEMA=false
SUPABASE_RLS_REQUIRED_BEFORE_EXPOSURE=true

POSTGRES_POOL_MAX=5
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECTION_TIMEOUT_MS=5000
# ============================================================
# Web / Vite: these are embedded at build time
# ============================================================
VITE_ADMIN_DATA_SOURCE=api

# Keep this exactly as /api.
# Nginx routes it internally to the API container.


VITE_SUPABASE_URL=https://qpsiognqssbzbjedhuwc.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_aJ73qvqQvBFgl-SlytXWow_6LlLjEx2
