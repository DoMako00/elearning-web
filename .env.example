# Standalone frontend: the API runs and deploys separately.
VITE_API_BASE_URL=http://127.0.0.1:3000
VITE_ADMIN_DATA_SOURCE=api

# Public browser Auth configuration for the intended environment.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# VITE_ values are embedded in the browser bundle.
# Database URLs, service-role keys, API runtime selectors and certificates
# belong only to the independent backend environment.
